{
  "name": "kindbytes-frontend",
  "private": true,
  "description": "Frontend build for KindBytes: Tailwind CSS, Alpine.js, three.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i frontend/src/css/app.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i frontend/src/css/app.css -o static/css/app.css --watch",
    "build:js": "node frontend/scripts/build-js.mjs",
    "build": "npm run build:js && npm run build:css"
  },
  "dependencies": {
    "alpinejs": "3.14.9",
    "qrcodejs2": "0.0.2",
    "three": "0.128.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "tailwindcss": "3.4.17"
  }
}
